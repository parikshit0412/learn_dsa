{
  "name": "learn-dsa",
  "version": "1.0.0",
  "description": "Curated DSA Problem Solutions in TypeScript and Python with In-Depth Line-by-Line Explanations",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:all": "tsx --test src/**/*.test.ts",
    "verify:ts": "tsx src/verify_all.ts",
    "verify:py": "python python/verify_all.py",
    "verify:all": "tsx src/verify_all.ts && python python/verify_all.py"
  },
  "keywords": [
    "dsa",
    "leetcode",
    "typescript",
    "python",
    "algorithms",
    "data-structures"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
